[Unit]
Description=PuppyPi local network discovery (no motor control)
After=network.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/bin/python3 /opt/puppypi-discovery/discovery_service.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_UNIX

[Install]
WantedBy=multi-user.target
