diff --git a/puppypi_remote_camera/tests/test_watchdog_boundary.py b/puppypi_remote_camera/tests/test_watchdog_boundary.py
new file mode 100644
--- /dev/null
+++ b/puppypi_remote_camera/tests/test_watchdog_boundary.py
@@ -0,0 +1,112 @@
+"""A packet received just after expiry must not erase the expired interval."""
+import json
+import unittest
+from unittest.mock import patch
+
+from _paths import CLIENT_ID, OTHER_ID
+from remote_control import STOP, V2Session, RemoteControlServer
+
+ADDRESS = ("127.0.0.1", 43000)
+
+
+def command(sequence, active=True, client=CLIENT_ID):
+    return json.dumps(dict(protocol=2, type="command", client_id=client,
+                          sequence=sequence, control_active=active,
+                          forward=0.6 if active else 0.0, turn=-0.3 if active else 0.0)).encode()
+
+
+class WatchdogBoundaryTests(unittest.TestCase):
+    def session(self):
+        session = V2Session(5, 3, 0.2, 0.25, 1.0)
+        session.handle_datagram(command(1, False), ADDRESS, 0)
+        session.handle_datagram(command(2), ADDRESS, 0)
+        return session
+
+    def test_packet_after_boundary_cannot_hide_timeout(self):
+        s = self.session()
+        self.assertEqual(s.check_timeouts(0.249), [])
+        result = s.handle_datagram(command(3), ADDRESS, 0.251)
+        self.assertFalse(result.ack["accepted"])
+        self.assertEqual(result.ack["reason"], "neutral_required")
+        self.assertEqual(result.velocity, STOP)
+        self.assertEqual(s.target, STOP)
+
+    def test_exact_boundary_also_expires(self):
+        self.assertFalse(self.session().handle_datagram(command(3), ADDRESS, 0.25).ack["accepted"])
+
+    def test_before_boundary_still_accepts(self):
+        self.assertTrue(self.session().handle_datagram(command(3), ADDRESS, 0.249).ack["accepted"])
+
+    def test_invalid_and_foreign_packets_still_return_stop_on_expiry(self):
+        for data in (b"{bad", command(3, client=OTHER_ID), command(2)):
+            with self.subTest(data=data):
+                result = self.session().handle_datagram(data, ADDRESS, 0.251)
+                self.assertFalse(result.ack["accepted"])
+                self.assertEqual(result.velocity, STOP)
+
+    def test_new_neutral_then_new_active_is_required(self):
+        s = self.session()
+        s.handle_datagram(command(3), ADDRESS, 0.251)
+        self.assertTrue(s.handle_datagram(command(4, False), ADDRESS, 0.26).ack["accepted"])
+        self.assertTrue(s.handle_datagram(command(5), ADDRESS, 0.27).ack["accepted"])
+
+    def test_expired_lease_accepts_new_owner_only_after_stop(self):
+        s = self.session()
+        result = s.handle_datagram(command(1, client=OTHER_ID), ("127.0.0.1", 44000), 1.01)
+        self.assertFalse(result.ack["accepted"])
+        self.assertEqual(result.ack["reason"], "neutral_required")
+        self.assertEqual(result.velocity, STOP)
+
+    def test_server_publishes_stop_even_when_expiring_packet_is_invalid(self):
+        emitted = []
+        config = dict(protocol_version=2, control_port=5001, command_timeout_seconds=0.25,
+                      velocity_limits=dict(max_forward_cm_s=5, max_reverse_cm_s=3, max_yaw_rate_rad_s=0.2))
+        server = RemoteControlServer(config, lambda *v: emitted.append(v))
+        with patch("remote_control.time.monotonic", return_value=0):
+            server._handle_datagram(command(1, False), ADDRESS)
+            server._handle_datagram(command(2), ADDRESS)
+        emitted.clear()
+        with patch("remote_control.time.monotonic", return_value=0.251):
+            server._handle_datagram(b"{bad", ADDRESS)
+        self.assertTrue(emitted)
+        self.assertEqual(emitted[0], STOP)
+        self.assertTrue(all(v == STOP for v in emitted))
+
+    def test_server_publishes_stop_before_rejecting_late_active(self):
+        emitted, acks = [], []
+        config = dict(protocol_version=2, control_port=5001, command_timeout_seconds=0.25,
+                      velocity_limits=dict(max_forward_cm_s=5, max_reverse_cm_s=3, max_yaw_rate_rad_s=0.2))
+        server = RemoteControlServer(config, lambda *v: emitted.append(v))
+        server._send_payload = lambda address, payload: acks.append(payload)
+        with patch("remote_control.time.monotonic", return_value=0):
+            server._handle_datagram(command(1, False), ADDRESS)
+            server._handle_datagram(command(2), ADDRESS)
+        emitted.clear()
+        with patch("remote_control.time.monotonic", return_value=0.251):
+            server._handle_datagram(command(3), ADDRESS)
+        self.assertTrue(emitted)
+        self.assertTrue(all(v == STOP for v in emitted))
+        self.assertEqual(acks[-1]["reason"], "neutral_required")
+
+    def test_failed_expiry_stop_latches_fault_before_new_packet(self):
+        fail = [False]
+
+        def publish(*velocity):
+            if fail[0]:
+                raise RuntimeError("stop publisher unavailable")
+
+        config = dict(protocol_version=2, control_port=5001, command_timeout_seconds=0.25,
+                      velocity_limits=dict(max_forward_cm_s=5, max_reverse_cm_s=3, max_yaw_rate_rad_s=0.2))
+        server = RemoteControlServer(config, publish)
+        with patch("remote_control.time.monotonic", return_value=0):
+            server._handle_datagram(command(1, False), ADDRESS)
+            server._handle_datagram(command(2), ADDRESS)
+        fail[0] = True
+        with patch("remote_control.time.monotonic", return_value=0.251):
+            server._handle_datagram(command(3), ADDRESS)
+        self.assertEqual(server.state_snapshot()["state"], "fault")
+        self.assertEqual(server._v2.target, STOP)
+
+
+if __name__ == "__main__":
+    unittest.main()
